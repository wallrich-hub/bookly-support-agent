# Copy to .env and fill in. Every script and the app read it automatically,
# so a new terminal tab does not need anything re-exported.
#
#   cp .env.example .env
#
# A variable set in your real environment always overrides this file.
# .env is gitignored - never commit a key.

# ---- Language model -------------------------------------------------------
# Default is the deterministic mock planner - no key needed.
# LLM_PROVIDER=anthropic
# ANTHROPIC_API_KEY=sk-ant-...
# LLM_MODEL=claude-sonnet-4-5

# LLM_PROVIDER=openai
# OPENAI_API_KEY=sk-...
# LLM_MODEL=gpt-4o

# ---- Order Management System ----------------------------------------------
# memory (default) = in-process seed data, offline and deterministic.
# http             = live REST calls against a mockapi.io project.
# OMS_BACKEND=http
# OMS_BASE_URL=https://<your-token>.mockapi.io/api/v1

# ---- Payments -------------------------------------------------------------
# ledger (default) = in-process refund records, offline.
# stripe           = real refunds against Stripe TEST mode.
# A live key (sk_live_...) is refused at startup, deliberately.
# PAYMENTS_BACKEND=stripe
# STRIPE_API_KEY=sk_test_...

# ---- Testing --------------------------------------------------------------
# Freeze "now" so date-dependent policy rules are reproducible.
# BOOKLY_NOW=2026-09-07T10:00:00+00:00
